/* Pairing window */
"Pair New Device" = "配對新裝置";
"Pair a Phone" = "配對手機";
"Open ATA on your Android phone and scan this code." = "在 Android 手機上打開 ATA，掃描這個 QR 碼。";
"Pairing QR code" = "配對 QR 碼";
"Waiting for phone · expires in %lld:%@" = "等待手機中 · %lld:%@ 後失效";
