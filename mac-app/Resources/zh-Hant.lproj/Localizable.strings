   reference (這台 Mac). */

/* Menu */
"Open Bluetooth Privacy Settings…" = "打開藍牙隱私權設定…";
"Open ATA Window" = "打開 ATA 視窗";
"Pair New Device…" = "配對新裝置…";
"No Paired Devices" = "沒有已配對的裝置";
"Paired Devices" = "已配對的裝置";
"Paired %@" = "配對於 %@";
"Remove “%@”" = "移除「%@」";
"No Recent Files" = "沒有最近的檔案";
